# Moonlight Photo Studio backend configuration.
# Copy to backend/.env and fill in. backend/.env is git-ignored. Never commit real values.
#
# Every value below is a safe development default or an empty placeholder. Integrations that
# are left empty stay disabled or offline (mock email, local storage, no Groq, no Google).
# ENVIRONMENT=production refuses to start until the production requirements are met
# (see "Production checklist" at the end of this file).

# --- Application -----------------------------------------------------------------------------
APP_NAME=Moonlight Photo Studio API
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_V1_STR=/api/v1
LOG_LEVEL=INFO

# --- MongoDB ---------------------------------------------------------------------------------
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<username>:<url_encoded_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=MoonlightStudio
#         URL-encode special characters in the password:
#         python -c "import urllib.parse; print(urllib.parse.quote_plus('your_password'))"
# Use a Moonlight-only cluster or database user. Never point this at another product's data.
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=moonlight_studio
MONGODB_TIMEOUT_MS=10000

# --- CORS (JSON array or comma-separated). The Vite dev server runs on :5173 -----------------
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# --- Auth & secrets --------------------------------------------------------------------------
# Generate each one separately:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
OTP_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# Refresh-token cookie (httpOnly; Secure is forced on in production). The refresh token is
# never returned in a response body. Endpoints using it require the X-CSRF-Protection: 1 header.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Default: <API_V1_STR>/auth
REFRESH_COOKIE_PATH=
# A refresh token rotated less than this many seconds ago counts as a concurrent refresh (two
# tabs), not theft: the late request gets an access token and the session is kept.
REFRESH_REUSE_GRACE_SECONDS=30

# Reverse proxies (IPs/CIDRs, comma-separated) whose X-Forwarded-For / X-Real-IP are trusted
# for client IPs. Empty = trust none (the socket peer is the client). Behind Cloudflare, list
# Cloudflare's ranges; behind a load balancer, its subnet.
TRUSTED_PROXIES=

# Google Sign-In: OAuth 2.0 Web client ID from Moonlight's own Google Cloud project.
# Empty = POST /auth/google answers 503 (sign-in disabled).
GOOGLE_CLIENT_ID=

# --- Rate limiting ---------------------------------------------------------------------------
# mongodb = shared across workers/instances (TTL collection "rate_limits"; required in production)
# memory  = per process, bounded (tests / single-process dev without MongoDB)
RATE_LIMIT_BACKEND=mongodb
# Login: per client IP + account, per account (all IPs), per client IP (all accounts)
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_LOGIN_IDENTIFIER_MAX_ATTEMPTS=20
RATE_LIMIT_LOGIN_IDENTIFIER_WINDOW_SECONDS=900
RATE_LIMIT_LOGIN_IP_MAX_ATTEMPTS=30
RATE_LIMIT_LOGIN_IP_WINDOW_SECONDS=300
RATE_LIMIT_REGISTER_MAX_ATTEMPTS=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=300
RATE_LIMIT_PHOTO_UPLOAD_MAX_ATTEMPTS=30
RATE_LIMIT_PHOTO_UPLOAD_WINDOW_SECONDS=3600
# Password reset: code requests (per email / per IP), code checks, final reset step
RATE_LIMIT_FORGOT_PASSWORD_MAX_ATTEMPTS=3
RATE_LIMIT_FORGOT_PASSWORD_WINDOW_SECONDS=900
RATE_LIMIT_FORGOT_PASSWORD_IP_MAX_ATTEMPTS=10
RATE_LIMIT_FORGOT_PASSWORD_IP_WINDOW_SECONDS=3600
RATE_LIMIT_OTP_VERIFY_IP_MAX_ATTEMPTS=15
RATE_LIMIT_OTP_VERIFY_IP_WINDOW_SECONDS=300
RATE_LIMIT_OTP_VERIFY_EMAIL_MAX_ATTEMPTS=10
RATE_LIMIT_OTP_VERIFY_EMAIL_WINDOW_SECONDS=900
RATE_LIMIT_PASSWORD_RESET_IP_MAX_ATTEMPTS=10
RATE_LIMIT_PASSWORD_RESET_IP_WINDOW_SECONDS=900

# --- Request limits (enforced while the body streams in, before it is buffered) -------------
MAX_REQUEST_BODY_BYTES=1048576
QUOTE_PREVIEW_MAX_MB=15

# --- Detailed GET /health diagnostics -------------------------------------------------------
# Open in development. Elsewhere it answers 404 unless the X-Health-Token header matches this
# value (>= 16 characters). /health/live and /health/ready are always public and minimal.
HEALTH_DIAGNOSTICS_TOKEN=

# --- Object storage --------------------------------------------------------------------------
# local = files under LOCAL_STORAGE_PATH (development; relative paths resolve from backend/)
# r2    = Cloudflare R2 (required in production)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=storage/local
LOCAL_STORAGE_URL_EXPIRATION_SECONDS=3600

# Cloudflare R2 (only used when STORAGE_BACKEND=r2). Use a private, Moonlight-only bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=moonlight-studio-photos
R2_CUSTOM_DOMAIN=
R2_ENDPOINT_URL=
R2_MAX_UPLOAD_MB=25

# --- WhatsApp quote requests & shareable design reports --------------------------------------
# International format, digits only (no +). 919876543210 is a placeholder (rejected in production).
BUSINESS_WHATSAPP_NUMBER=919876543210
PUBLIC_APP_URL=http://localhost:5173
QUOTE_SHARE_EXPIRY_DAYS=30

# --- Groq AI layout curator (optional; the planner works fully without it) ------------------
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=10
GROQ_MAX_OUTPUT_TOKENS=256
GROQ_DAILY_REQUEST_LIMIT=100
GROQ_DAILY_TOKEN_BUDGET=50000

# --- Transactional email (password-reset codes) ----------------------------------------------
# mock   = codes are recorded and logged at DEBUG level in development (nothing is sent)
# resend = live delivery through Resend (requires RESEND_API_KEY)
EMAIL_PROVIDER=mock
RESEND_API_KEY=
# Development: "Moonlight Photo Studio <onboarding@resend.dev>"
# Production:  an address on a domain verified in Resend, e.g. "Moonlight Photo Studio <security@your-domain>"
RESEND_FROM_EMAIL=Moonlight Photo Studio <onboarding@resend.dev>
# While true, Resend only delivers to RESEND_TEST_RECIPIENT (the Resend account owner).
RESEND_TEST_MODE=true
RESEND_TEST_RECIPIENT=
EMAIL_OTP_EXPIRE_MINUTES=10
EMAIL_OTP_COOLDOWN_SECONDS=60

# --- Production checklist (ENVIRONMENT=production refuses to start otherwise) ----------------
#   SECRET_KEY, OTP_SECRET_KEY : unique, >= 32 characters, different from each other
#   DEBUG=false
#   RATE_LIMIT_BACKEND=mongodb
#   TRUSTED_PROXIES = your proxy / load balancer ranges (otherwise every client shares one IP)
#   STORAGE_BACKEND=r2 with R2_ACCOUNT_ID (or R2_ENDPOINT_URL), R2_ACCESS_KEY_ID,
#     R2_SECRET_ACCESS_KEY, R2_BUCKET_NAME
#   EMAIL_PROVIDER=resend, RESEND_TEST_MODE=false
#   GROQ_API_KEY when GROQ_ENABLED=true
#   BUSINESS_WHATSAPP_NUMBER = the real business number
#   PUBLIC_APP_URL and CORS_ORIGINS = the https:// production origins
